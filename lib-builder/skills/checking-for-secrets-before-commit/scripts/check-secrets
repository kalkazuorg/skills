#!/usr/bin/env bash
# Scan what is staged for commit for secrets: secret files (.env, private
# keys, credential files), known token formats, and hardcoded assignments to
# key/secret/token/password names. Also flags .env files in the working tree
# that .gitignore does not cover.
#
# Findings print as "path:line  kind". The matched value is never printed —
# not whole, not in part — so the output is safe to show and to log.
#
# Usage: check-secrets            (run inside the repository, after git add)
# Exit:  0 clean, 1 findings, 2 not a git repository
set -euo pipefail

git rev-parse --git-dir >/dev/null 2>&1 || {
  echo "check-secrets: not a git repository" >&2
  exit 2
}

findings=0
report() {
  printf '  %s  %s\n' "$1" "$2"
  findings=$((findings + 1))
}

# Example files carry variable names with empty or placeholder values.
is_example() {
  case "$1" in
    *.example | *.sample | *.template | *.dist) return 0 ;;
  esac
  return 1
}

secret_file_kind() {
  local base="${1##*/}"
  case "$base" in
    .env | .env.*) is_example "$base" || echo "environment file with secrets" ;;
    *.pem | *.key | *.p12 | *.pfx) echo "private key or certificate file" ;;
    id_rsa* | id_ed25519* | id_ecdsa* | id_dsa*) echo "SSH private key file" ;;
    credentials.json | secrets.json | secrets.yml | secrets.yaml | secrets.toml) echo "credentials file" ;;
  esac
}

# First matching kind for one added line, or nothing.
secret_line_kind() {
  local line="$1"
  local re_generic='(api[_-]?key|secret|token|passw(or)?d|pwd)[a-z0-9_]*["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"'[:space:]]{8,}["'"'"']'
  local re_dotenv='^[[:space:]]*(export[[:space:]]+)?[A-Z0-9_]*(KEY|SECRET|TOKEN|PASSWORD|PASSWD)[A-Z0-9_]*=[^[:space:]$]{8,}'
  if printf '%s' "$line" | grep -Eq -- '-----BEGIN ([A-Z]+ )*PRIVATE KEY-----'; then echo "private key block"
  elif printf '%s' "$line" | grep -Eq '(^|[^A-Z0-9])(AKIA|ASIA)[A-Z0-9]{16}([^A-Z0-9]|$)'; then echo "AWS access key"
  elif printf '%s' "$line" | grep -Eq '(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}'; then echo "GitHub token"
  elif printf '%s' "$line" | grep -Eq 'xox[abprs]-[A-Za-z0-9-]{10,}'; then echo "Slack token"
  elif printf '%s' "$line" | grep -Eq '(sk|rk)_(live|test)_[A-Za-z0-9]{16,}'; then echo "Stripe key"
  elif printf '%s' "$line" | grep -Eq 'sk-ant-[A-Za-z0-9_-]{20,}'; then echo "Anthropic API key"
  elif printf '%s' "$line" | grep -Eq 'sk-(proj-)?[A-Za-z0-9_-]{20,}'; then echo "OpenAI-style API key"
  elif printf '%s' "$line" | grep -Eq 'AIza[0-9A-Za-z_-]{35}'; then echo "Google API key"
  elif printf '%s' "$line" | grep -Eiq -- "$re_generic"; then echo "hardcoded secret assignment"
  elif printf '%s' "$line" | grep -Eq -- "$re_dotenv"; then echo "hardcoded secret assignment"
  fi
}

# .env files that exist but are neither tracked nor ignored.
while IFS= read -r f; do
  [ -n "$f" ] || continue
  base="${f##*/}"
  case "$base" in
    .env | .env.*)
      is_example "$base" || report "$f" "environment file not covered by .gitignore (add it to .gitignore)"
      ;;
  esac
done < <(git ls-files --others --exclude-standard)

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -z "$staged" ] && [ "$findings" -eq 0 ]; then
  echo "check-secrets: nothing staged"
  exit 0
fi

while IFS= read -r f; do
  [ -n "$f" ] || continue
  kind="$(secret_file_kind "$f")"
  [ -z "$kind" ] || report "$f" "$kind"
done <<<"$staged"

# Added lines only (removing a secret is not a finding), with their new line
# numbers, as "path<TAB>line<TAB>content".
while IFS=$'\t' read -r f n content; do
  [ -n "$f" ] || continue
  kind="$(secret_line_kind "$content")"
  [ -z "$kind" ] || report "$f:$n" "$kind"
done < <(git diff --cached -U0 --no-color --no-ext-diff --diff-filter=ACMR | awk '
  /^\+\+\+ / { file = substr($0, 5); sub(/^b\//, "", file); next }
  /^@@ / {
    split($3, a, ",")
    ln = substr(a[1], 2) + 0
    next
  }
  /^\+/ { printf "%s\t%d\t%s\n", file, ln, substr($0, 2); ln++; next }
')

if [ "$findings" -eq 0 ]; then
  echo "check-secrets: no secrets found in $(printf '%s\n' "$staged" | grep -c .) staged file(s)"
  exit 0
fi

cat <<EOF

check-secrets: $findings finding(s). Values are not shown.
Unstage each one (git restore --staged <file>), move the value to an
environment variable or an ignored .env, and rotate any key that was ever
committed, pushed or shared.
EOF
exit 1
